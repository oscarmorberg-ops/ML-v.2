#!/usr/bin/env python3
import boto3
import botocore
from concurrent.futures import ThreadPoolExecutor

class S3CyberScanner:
    def __init__(self):
        self.session = boto3.Session()
        self.s3 = self.session.client('s3')
    def check_bucket_access(self, bucket):
        try:
            self.s3.list_objects_v2(Bucket=bucket, MaxKeys=1)
            return {"bucket": bucket, "status": "✅ LISTABLE"}
        except botocore.exceptions.ClientError as e:
            code = e.response['Error']['Code']
            if code == 'NoSuchBucket':
                return {"bucket": bucket, "status": "❌ NO"}
            elif code == 'AccessDenied':
                return {"bucket": bucket, "status": "🔒 PRIVATE"}
            return {"bucket": bucket, "status": f"⚠️ {code}"}
        except:
            return {"bucket": bucket, "status": "❌ ERROR"}

def generate_buckets(company):
    base = company.lower().replace(" ", "").replace(".", "").replace("-", "")
    years = ['2020','2021','2022','2023','2024','2025','2026']
    envs = ['prod','staging','dev','test','qa','stage','development']
    types = ['backup','logs','static','uploads','archive','temp','data','assets','images','files','cdn','www','web','media','documents']
    buckets = set()
    for year in years:
        for env in envs:
            for typ in types:
                buckets.update([f"{base}-{env}-{typ}",f"{base}-{env}-{typ}-{year}",f"{base}-{typ}-{env}",f"{env}-{base}-{typ}",f"{base}-{typ}-{year}",f"{typ}-{base}-{env}",f"{base}-{year}-{env}"])
    buckets.update([f"{base}", f"{base}-s3", f"{base}-bucket", f"{base}-public",f"{base}-files", f"{base}-cdn", f"{base}-website", f"{base}-app"])
    return list(buckets)[:200]

def main():
    company = input("🎯 Företag: ") or "targetcorp"
    buckets = generate_buckets(company.lower())
    print(f"🚀 MAX SCAN: {len(buckets)} buckets för {company}")
    print("⚡ 200 workers - FULL AGGRESSION!")
    scanner = S3CyberScanner()
    with ThreadPoolExecutor(max_workers=200) as executor:
        results = list(executor.map(scanner.check_bucket_access, buckets))
    listable = [r for r in results if r["status"] == "✅ LISTABLE"]
    private = [r for r in results if r["status"] == "🔒 PRIVATE"]
    others = [r for r in results if r["status"] not in ["✅ LISTABLE", "🔒 PRIVATE"]]
    print("\n"+"="*60)
    print(f"🎯 MAX SCAN FÄRDIG!")
    print(f"🚨 LISTABLE: {len(listable)}")
    print(f"🔒 PRIVATE:  {len(private)}")
    print(f"❌ ÖVRIGT:   {len(others)}")
    print("="*60)
    if listable:
        print("\n🚨 OFFENTLIGA BUCKETS:")
        for r in listable: print(f"  ✅ {r['bucket']}")
    if private:
        print("\n🔒 PRIVATE BUCKETS (potentiella targets):")
        for r in private[:20]: print(f"  🔒 {r['bucket']}")

if __name__ == "__main__":
    main()
