# 🔧 CSIO AUTO-VENV (ZSH - Production ready)
csio_auto_venv() {
  if [[ -d .venv && ! -f Cargo.toml ]]; then
    source .venv/bin/activate 2>/dev/null && echo "🐍 .venv LIVE!"
  elif [[ -n "$VIRTUAL_ENV" ]]; then
    deactivate 2>/dev/null && echo "🔒 venv off"
  fi
}

# ENBART chpwd hook (ingen cd override)
autoload -Uz add-zsh-hook
add-zsh-hook chpwd csio_auto_venv

# Cyber aliases
alias cyber="source .venv/bin/activate && echo '🐍 VENV LIVE!'"
alias cciso-start="cyber && docker-compose up &"

# AWS + PATH
export AWS_DEFAULT_REGION=eu-north-1
