#!/usr/bin/env python3
import boto3
from botocore.exceptions import ClientError
import sys

def scan_bucket(bucket):
    try:
        s3 = boto3.client('s3')
        s3.list_objects_v2(Bucket=bucket, MaxKeys=1)
        print(f"✅ OPEN: {bucket}")
        return True
    except ClientError as e:
        code = e.response['Error']['Code']
        if code == 'AuthorizationHeaderMalformed':
            print(f"❌ CLOSED: {bucket}")
        else:
            print(f"❌ ERROR: {bucket} ({code})")
        return False

if __name__ == "__main__":
    buckets = sys.argv[1:] if len(sys.argv) > 1 else ['test-bucket-1', 'test-bucket-2']
    for bucket in buckets:
        scan_bucket(bucket)
    print("Scan complete!")

def scan_multi_region(bucket):
    regions = ["us-east-1", "eu-north-1", "eu-west-1"]
    for region in regions:
        try:
            s3 = boto3.client("s3", region_name=region)
            s3.list_objects_v2(Bucket=bucket, MaxKeys=1)
            print(f"✅ OPEN ({region}): {bucket}")
            return True
        except:
            continue
    print(f"❌ CLOSED: {bucket}")
    return False


def scan_multi_region(bucket):
    regions = ["us-east-1", "eu-north-1", "eu-west-1"]
    for region in regions:
        try:
            s3 = boto3.client("s3", region_name=region)
            s3.list_objects_v2(Bucket=bucket, MaxKeys=1)
            print(f"✅ OPEN ({region}): {bucket}")
            return True
        except:
            continue
    print(f"❌ CLOSED: {bucket}")
    return False

cat > s3_scanner.py << 'EOF'
#!/usr/bin/env python3
import boto3
from botocore.exceptions import ClientError
import sys

def scan_bucket(bucket):
    """Fallback: enkel region scan"""
    try:
        s3 = boto3.client('s3')
        s3.list_objects_v2(Bucket=bucket, MaxKeys=1)
        print(f"✅ OPEN: {bucket}")
        return True
    except ClientError as e:
        code = e.response['Error']['Code']
        if code == 'AuthorizationHeaderMalformed':
            print(f"❌ CLOSED: {bucket}")
        else:
            print(f"❌ ERROR: {bucket} ({code})")
        return False

def scan_multi_region(bucket):
    """Ny: Multi-region scanning"""
    regions = ["us-east-1", "eu-north-1", "eu-west-1", "ap-southeast-1"]
    for region in regions:
        try:
            s3 = boto3.client("s3", region_name=region)
            s3.list_objects_v2(Bucket=bucket, MaxKeys=1)
            print(f"✅ OPEN ({region}): {bucket}")
            return True
        except:
            continue
    print(f"❌ CLOSED: {bucket}")
    return False

if __name__ == "__main__":
    buckets = sys.argv[1:] if len(sys.argv) > 1 else ['test-bucket-1', 'test-bucket-2']
    print("🚀 Multi-region S3 Scanner v2.0")
    for bucket in buckets:
        scan_multi_region(bucket)  # ← ANVÄND DEN NYA!
    print("Scan complete! ✅")
EOF

python3 s3_scanner.py
# → 🚀 Multi-region S3 Scanner v2.0
