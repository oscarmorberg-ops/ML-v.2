#!/usr/bin/env python3
"""
🚀 Cybersec S3 Pipeline v2.2 - PRO S3 Scanner
"""

import boto3
import botocore
from concurrent.futures import ThreadPoolExecutor
import sys

class S3CyberScanner:
    def __init__(self):
        self.config = botocore.config.Config(
            connect_timeout=2, 
            read_timeout=3,
            retries={'max_attempts': 1}
        )
        self.session = boto3.Session()
        self.s3 = self.session.client('s3', config=self.config)
    
    def check_bucket_access(self, bucket):
        try:
            self.s3.list_objects_v2(Bucket=bucket, MaxKeys=1)
            return {"bucket": bucket, "status": "✅ LISTABLE"}
        except botocore.exceptions.ClientError as e:
            code = e.response['Error']['Code']
            if code == 'NoSuchBucket':
                return {"bucket": bucket, "status": "❌ NO"}
            elif code == 'AccessDenied':
                return {"bucket": bucket, "status": "🔒 PRIVATE"}
            return {"bucket": bucket, "status": f"⚠️ {code}"}
        except:
            return {"bucket": bucket, "status": "❌ ERROR"}

def generate_buckets(company):
    """Generera 200+ realistiska AWS S3 namn"""
    years = ['2023','2024','2025','2026']
    envs = ['prod','staging','dev','test']
    types = ['backup','logs','static','uploads','archive','temp','data','assets']
    
    buckets = set()
    for year in years:
        for env in envs:
            for typ in types:
                buckets.update([
                    f"{company}-{env}-{typ}",
                    f"{company}-{env}-{typ}-{year}",
                    f"{company}-{typ}-{env}",
                    f"{company}-{typ}-{year}",
                    f"{env}-{company}-{typ}"
                ])
    return list(buckets)[:200]
