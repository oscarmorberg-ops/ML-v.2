for b in publics:
    print(f"  🚨 {b['bucket']}")
print(f"🔒 PRIVATA: {len(privates)}")
print(f"❌ FÖRSVUNNA: {len(buckets) - len(publics) - len(privates)}")

    buckets = generate_buckets(company.lower())
    
    print(f"🔍 Scanning {len(buckets)} buckets för {company}..")
    
