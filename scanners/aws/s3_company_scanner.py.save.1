#!/usr/bin/env python3
from concurrent.futures import ThreadPoolExecutor
import requests

class S3CyberScanner:
    def check_bucket_access(self, bucket):
        try:
            r = requests.head(f"https://{bucket}", timeout=3)
            if r.status_code == 403: 
                return {"bucket":bucket,"status":"🔒 PRIVATE"}
            if r.status_code == 200: 
                return {"bucket":bucket,"status":"✅ LISTABLE"}
            return {"bucket":bucket,"status":f"❌ {r.status_code}"}
        except: 
            return {"bucket":bucket,"status":"⏰ TIMEOUT"}

def generate_buckets(company):
    base = company.lower().replace(" ","").replace(".","").replace("-","")
    patterns = ["","s3","bucket","prod","dev","logs","backup","data","assets","static","media","images","uploads","content","files","storage","cdn","public","www","app","api","test","staging","archive","temp","raw","processed","analytics"]
    return [f"{base}-{e}.s3.amazonaws.com" for e in patterns]

REGIONS = ['us-east-1', 'eu-west-1', 'eu-north-1']
    all_buckets = []
    
    for pattern in patterns:
    buckets = generate_buckets(company.lower())
    
    print(f"🔍 Scanning {len(buckets)} buckets för {company}...")
    
    scanner = S3CyberScanner()
    with ThreadPoolExecutor(max_workers=50) as executor:
        results = list(executor.map(scanner.check_bucket_access, buckets))

    print("📋 RESULTAT:")
    for r in results:
        print(f"  {r['status']} {r['bucket']}")
    
    publics = [r for r in results if "LISTABLE" in r["status"]]
    privates = [r for r in results if "PRIVATE" in r["status"]]
    
    print(f"🚨 LISTABLE: {len(publics)}")
    print(f"🔒 PRIVATE: {len(privates)}")
    print(f"⏰ TIMEOUT/ERROR: {len(buckets)-len(publics)-len(privates)}")

if __name__ == "__main__":
    main()
